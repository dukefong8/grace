let key = env:DEEPSEEK_API_KEY : Key

let concatSep = import github
      { owner: "Gabriella439"
      , repository: "grace"
      , path: "prelude/text/concatSep.ffg"
      }

let call = fold
      { HttpRequest { url }: "curl ${url}"
      , ShellCommand { executable, arguments}:
          concatSep " " ([ executable ] + arguments)
      }

in map call (prompt{ key
                   , model: "deepseek-v4-flash"
                   , text: "Call some tools" })
